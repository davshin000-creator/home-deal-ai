                ) : null}
              </div>
            </div>
          </div>

          <div className="grid gap-px bg-white/10 md:grid-cols-3">
            <div className="bg-[#090909] p-6 md:p-8">
              <p className="text-xs font-bold uppercase tracking-[0.16em] text-white/30">
                Opportunity Score

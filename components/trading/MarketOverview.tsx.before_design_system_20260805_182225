type MarketState = {
  base_asset?: string;
  regime?: string;
  confidence?: number;
  risk?: string;
  research_style?: string;
  data_time?: string | null;
  source_available?: boolean;
};

type Opportunity = {
  symbol?: string;
  asset_name?: string;
  asset_type?: string;
  opportunity_score?: number;
  confidence?: number;
  regime?: string;
  risk?: string;
};

type CouncilState = {
  consensus?: string;
  confidence?: number;
  veto?: boolean;
  agent_count?: number;
};

type MarketOverviewProps = {
  market?: MarketState;
  opportunities?: Opportunity[];
  council?: CouncilState;
};

function cleanLabel(value?: string | null) {
  const normalized = String(value ?? "Unknown")
    .replaceAll("_", " ")
    .replaceAll("-", " ")
    .replace(/\s+/g, " ")
    .trim();

  return normalized
    .toLowerCase()
    .replace(
      /\b\w/g,
      (letter) => letter.toUpperCase(),
    );
}

function clampScore(value?: number) {
  return Math.max(
    0,
    Math.min(
      100,
      Math.round(value ?? 0),
    ),
  );
}

function riskClasses(value?: string) {
  switch (String(value ?? "").toUpperCase()) {
    case "LOW":
      return "border-emerald-400/20 bg-emerald-400/10 text-emerald-200";
    case "HIGH":
    case "CRITICAL":
      return "border-red-400/20 bg-red-400/10 text-red-200";
    default:
      return "border-amber-400/20 bg-amber-400/10 text-amber-100";
  }
}

function scoreClasses(score: number) {
  if (score >= 80) {
    return "text-emerald-300";
  }

  if (score >= 65) {
    return "text-cyan-200";
  }

  if (score >= 50) {
    return "text-amber-200";
  }

  return "text-orange-200";
}

export default function MarketOverview({
  market,
  opportunities = [],
  council,
}: MarketOverviewProps) {
  const confidence = clampScore(
    market?.confidence,
  );

  const rankedOpportunities = [...opportunities]
    .sort(
      (first, second) =>
        (second.opportunity_score ?? 0) -
        (first.opportunity_score ?? 0),
    )
    .slice(0, 4);

  const cryptoCount = opportunities.filter(
    (item) => item.asset_type === "crypto",
  ).length;

  const stockCount = opportunities.filter(
    (item) => item.asset_type === "stock",
  ).length;

  return (
    <section className="h-full rounded-[32px] border border-white/10 bg-white/[0.04] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] md:p-7">
      <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p className="text-[10px] font-bold uppercase tracking-[0.2em] text-cyan-300/65">
            Market Overview
          </p>

          <h2 className="mt-3 text-3xl font-bold tracking-[-0.05em]">
            Current intelligence snapshot.
          </h2>

          <p className="mt-3 max-w-xl text-sm leading-6 text-white/38">
            Public read-only research across U.S. stocks and crypto.
          </p>
        </div>

        <span
          className={`inline-flex self-start rounded-full border px-4 py-2 text-xs font-bold ${riskClasses(
            market?.risk,
          )}`}
        >
          {cleanLabel(market?.risk)} Risk
        </span>
      </div>

      <div className="mt-7 grid gap-4 sm:grid-cols-2">
        <article className="rounded-[22px] border border-white/10 bg-black/20 p-5">
          <p className="text-[9px] font-bold uppercase tracking-[0.16em] text-white/28">
            Market Regime
          </p>

          <p className="mt-3 text-2xl font-black">
            {cleanLabel(market?.regime)}
          </p>

          <p className="mt-2 text-xs text-white/30">
            Base reference: {market?.base_asset ?? "Market"}
          </p>
        </article>

        <article className="rounded-[22px] border border-white/10 bg-black/20 p-5">
          <p className="text-[9px] font-bold uppercase tracking-[0.16em] text-white/28">
            AI Confidence
          </p>

          <p className="mt-3 text-2xl font-black text-cyan-200">
            {confidence}%
          </p>

          <div className="mt-4 h-2 overflow-hidden rounded-full bg-white/10">
            <div
              className="h-full rounded-full bg-cyan-300"
              style={{
                width: `${confidence}%`,
              }}
            />
          </div>
        </article>

        <article className="rounded-[22px] border border-white/10 bg-black/20 p-5">
          <p className="text-[9px] font-bold uppercase tracking-[0.16em] text-white/28">
            Public Coverage
          </p>

          <p className="mt-3 text-2xl font-black">
            {opportunities.length}
          </p>

          <p className="mt-2 text-xs text-white/30">
            {stockCount} stocks · {cryptoCount} crypto
          </p>
        </article>

        <article className="rounded-[22px] border border-white/10 bg-black/20 p-5">
          <p className="text-[9px] font-bold uppercase tracking-[0.16em] text-white/28">
            Council Consensus
          </p>

          <p className="mt-3 break-words text-2xl font-black">
            {cleanLabel(council?.consensus)}
          </p>

          <p className="mt-2 text-xs text-white/30">
            {council?.agent_count ?? 0} research agents ·{" "}
            {clampScore(council?.confidence)}%
          </p>
        </article>
      </div>

      <div className="mt-6">
        <div className="flex items-center justify-between gap-4">
          <p className="text-[10px] font-bold uppercase tracking-[0.18em] text-white/30">
            Leading Opportunities
          </p>

          <p className="text-xs text-white/25">
            Current public ranking
          </p>
        </div>

        <div className="mt-4 space-y-3">
          {rankedOpportunities.length > 0 ? (
            rankedOpportunities.map(
              (item, index) => {
                const score = clampScore(
                  item.opportunity_score,
                );

                return (
                  <div
                    key={`${item.symbol}-${index}`}
                    className="flex items-center justify-between gap-4 rounded-[18px] border border-white/10 bg-white/[0.035] px-4 py-3"
                  >
                    <div className="min-w-0">
                      <p className="truncate font-bold">
                        {item.symbol ?? "Unknown"}
                      </p>

                      <p className="mt-1 truncate text-xs text-white/30">
                        {item.asset_name ??
                          cleanLabel(item.asset_type)}
                      </p>
                    </div>

                    <p
                      className={`shrink-0 text-xl font-black ${scoreClasses(
                        score,
                      )}`}
                    >
                      {score}
                    </p>
                  </div>
                );
              },
            )
          ) : (
            <p className="rounded-[18px] border border-white/10 bg-white/[0.035] p-4 text-sm text-white/35">
              Market opportunities are currently unavailable.
            </p>
          )}
        </div>
      </div>

      <p className="mt-6 text-xs leading-5 text-white/22">
        No brokerage balances, private positions, orders, or execution
        capability are included.
      </p>
    </section>
  );
}
